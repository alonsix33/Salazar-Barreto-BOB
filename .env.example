# Las variables de entorno de la app. Copia este fichero a `.env` y rellénalo.
#
#   cp .env.example .env
#
# **Ningún valor real vive aquí.** Este fichero se versiona; `.env` no.

# ── Base de datos ──────────────────────────────────────────────────────────
# PostgreSQL. En Railway salen del panel del servicio Postgres.
#
# `DATABASE_URL` es la que usa la app en marcha. En Vercel lleva
# `?connection_limit=1`: cada función abre su propio pool, y sin límite la base
# se queda sin conexiones. Va la URL **pública** de Railway (`DATABASE_PUBLIC_URL`,
# host `...proxy.rlwy.net` y puerto alto): la interna, `postgres.railway.internal`,
# solo existe dentro de Railway y Vercel no la alcanza.
DATABASE_URL="postgresql://usuario:contraseña@host:PUERTO/railway?connection_limit=1"

# `DIRECT_URL` es la conexión directa, sin pooler. La usa Prisma **solo para las
# migraciones**: un pooler en modo transacción no admite las sentencias que
# necesita un `ALTER TABLE`.
DIRECT_URL="postgresql://usuario:contraseña@host:5432/basededatos"

# ── Administración ─────────────────────────────────────────────────────────
# El PIN de cuatro dígitos que abre el panel. Lo cambia el desarrollador cuando
# rota el administrador: es una decisión del producto que no haya UI para eso.
#
# **Nunca lleva el prefijo `NEXT_PUBLIC_`.** Con ese prefijo Next lo mete en el
# JavaScript que descarga el navegador, y el PIN dejaría de ser un PIN.
ADMIN_PIN="0000"

# Clave para firmar la cookie de sesión de administración. Una cadena larga y
# aleatoria; si cambia, las sesiones abiertas se caen, que es lo correcto.
#
#   openssl rand -base64 32
ADMIN_SECRETO="cámbiala-por-una-cadena-larga-y-aleatoria"

# ── Bob ────────────────────────────────────────────────────────────────────
# **La clave manda.** Con `DEEPSEEK_API_KEY` puesta, Bob responde con el modelo;
# vacía, responde con el catálogo escrito a mano —sin clave, sin red y sin
# coste—. La interfaz es la misma en los dos casos, y en los dos Bob dice solo
# números que salen del sistema.
#
# Antes hacían falta dos variables de acuerdo y eso salió mal en producción: la
# clave estaba puesta, `BOB_MODO` no, y Bob llevaba semanas contestando con el
# catálogo sin que nada lo dijera. El panel de administración enseña ahora en
# qué modo está y por qué.
DEEPSEEK_API_KEY=""

# Opcional, el freno de mano: con cualquier valor, Bob usa solo el catálogo
# aunque haya clave. Para cortar el gasto sin borrarla.
BOB_SIN_MODELO=""

# Opcional. `deepseek-flash` (el nombre por defecto, en lib/bob/deepseek.ts)
# es el modelo de chat vigente. Se fija aquí solo cuando haga falta reproducir
# una respuesta concreta, o si DeepSeek vuelve a cambiar el nombre del modelo
# vigente antes de que el código se actualice —ya pasó dos veces en 2026—.
#
# Puesta y vacía —`DEEPSEEK_MODELO=""` en Vercel, copiada tal cual de aquí— no
# es lo mismo que ausente, y el código ya lo sabe: usa el nombre de arriba de
# todas formas. Antes no lo sabía, y esa fue la mitad real del porqué Bob
# nunca hablaba con el modelo en producción.
DEEPSEEK_MODELO=""

# Opcional. La base de la API. Solo se cambia para apuntar a un simulador.
# Mismo cuidado que `DEEPSEEK_MODELO`: puesta y vacía, el código usa
# `https://api.deepseek.com` igual. Vacía sin ese cuidado es justo lo que
# causó `Failed to parse URL from /chat/completions` en los logs reales.
DEEPSEEK_URL=""

# ── Notificaciones push ──────────────────────────────────────────────────────
# Las claves VAPID que firman los avisos push. Se generan una vez con:
#
#   npx web-push generate-vapid-keys
#
# La **pública** va con `NEXT_PUBLIC_` porque el navegador la necesita para
# suscribirse, y no es secreta. La **privada** firma los envíos desde el servidor
# y **nunca** lleva ese prefijo: con él acabaría en el JavaScript del navegador y
# cualquiera podría mandar avisos a nombre del edificio.
#
# Vacías, no hay push y la app funciona igual (el aviso de WhatsApp lo cubre).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# El "sujeto" del push: un mailto o una URL de contacto del administrador.
VAPID_SUBJECT="mailto:administracion@salazar-barreto.pe"

# ── La app ─────────────────────────────────────────────────────────────────
# La URL pública. La usan los enlaces de los avisos y el manifiesto de la PWA.
# Esta sí lleva `NEXT_PUBLIC_` porque el navegador la necesita, y no es secreta.
NEXT_PUBLIC_APP_URL="https://salazar-barreto.vercel.app"

# ── Solo para pruebas ──────────────────────────────────────────────────────
# Abre `POST /api/pruebas/resembrar`, que **borra la base entera** y la vuelve a
# escribir desde la semilla. Fuera de producción la ruta existe igualmente y pide
# PIN; en producción, sin esta variable, devuelve 404.
#
# En un servidor con datos de verdad, esto se queda vacío. Siempre.
PERMITIR_RESEMBRADO=""
