# Las variables de entorno de la app. Copia este fichero a `.env` y rellénalo.
#
#   cp .env.example .env
#
# **Ningún valor real vive aquí.** Este fichero se versiona; `.env` no.

# ── Base de datos ──────────────────────────────────────────────────────────
# PostgreSQL. En Railway salen del panel del servicio Postgres.
#
# `DATABASE_URL` es la que usa la app en marcha y conviene que vaya **con
# pooling**: Vercel abre y cierra funciones sin parar, y sin pooler la base se
# queda sin conexiones al segundo mes.
DATABASE_URL="postgresql://usuario:contraseña@host:5432/basededatos?pgbouncer=true&connection_limit=1"

# `DIRECT_URL` es la conexión directa, sin pooler. La usa Prisma **solo para las
# migraciones**: un pooler en modo transacción no admite las sentencias que
# necesita un `ALTER TABLE`.
DIRECT_URL="postgresql://usuario:contraseña@host:5432/basededatos"

# ── Administración ─────────────────────────────────────────────────────────
# El PIN de cuatro dígitos que abre el panel. Lo cambia el desarrollador cuando
# rota el administrador: es una decisión del producto que no haya UI para eso.
#
# **Nunca lleva el prefijo `NEXT_PUBLIC_`.** Con ese prefijo Next lo mete en el
# JavaScript que descarga el navegador, y el PIN dejaría de ser un PIN.
ADMIN_PIN="0000"

# Clave para firmar la cookie de sesión de administración. Una cadena larga y
# aleatoria; si cambia, las sesiones abiertas se caen, que es lo correcto.
#
#   openssl rand -base64 32
ADMIN_SECRETO="cámbiala-por-una-cadena-larga-y-aleatoria"

# ── Bob ────────────────────────────────────────────────────────────────────
# `determinista` responde con el catálogo escrito a mano: sin clave y sin coste.
# `deepseek` usa el modelo. La interfaz es la misma en los dos.
BOB_MODO="determinista"

# Vacía mientras `BOB_MODO=determinista`. No hace falta para nada más.
DEEPSEEK_API_KEY=""

# Opcional. `deepseek-chat` apunta siempre al modelo de chat vigente, que es lo
# que se quiere para no quedarse anclado a una versión. Se fija aquí solo cuando
# haga falta reproducir una respuesta concreta.
DEEPSEEK_MODELO=""

# Opcional. La base de la API. Solo se cambia para apuntar a un simulador.
DEEPSEEK_URL=""

# ── Notificaciones push ──────────────────────────────────────────────────────
# Las claves VAPID que firman los avisos push. Se generan una vez con:
#
#   npx web-push generate-vapid-keys
#
# La **pública** va con `NEXT_PUBLIC_` porque el navegador la necesita para
# suscribirse, y no es secreta. La **privada** firma los envíos desde el servidor
# y **nunca** lleva ese prefijo: con él acabaría en el JavaScript del navegador y
# cualquiera podría mandar avisos a nombre del edificio.
#
# Vacías, no hay push y la app funciona igual (el aviso de WhatsApp lo cubre).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# El "sujeto" del push: un mailto o una URL de contacto del administrador.
VAPID_SUBJECT="mailto:administracion@salazar-barreto.pe"

# ── La app ─────────────────────────────────────────────────────────────────
# La URL pública. La usan los enlaces de los avisos y el manifiesto de la PWA.
# Esta sí lleva `NEXT_PUBLIC_` porque el navegador la necesita, y no es secreta.
NEXT_PUBLIC_APP_URL="https://salazar-barreto.vercel.app"

# ── Solo para pruebas ──────────────────────────────────────────────────────
# Abre `POST /api/pruebas/resembrar`, que **borra la base entera** y la vuelve a
# escribir desde la semilla. Fuera de producción la ruta existe igualmente y pide
# PIN; en producción, sin esta variable, devuelve 404.
#
# En un servidor con datos de verdad, esto se queda vacío. Siempre.
PERMITIR_RESEMBRADO=""
